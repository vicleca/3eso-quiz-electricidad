# Node.js
node_modules/
npm-debug.log
yarn-error.log
package-lock.json # OPTIONAL: Remove this line if you WANT to version lock dependencies (Recommended to keep lock file, but some ignore it)

# OS System Files
.DS_Store
Thumbs.db

# Web Build Artifacts
# Your capacitor.config.json says "webDir": "www"
# 1. If 'www' contains your source code (HTML/CSS/JS you write manually), DO NOT ignore it.
# 2. If 'www' is generated by a build toolVt (like React/Vue/Angular build), uncomment the line below:
# www/
dist/
build/

# Capacitor - Android
# Note: We usually commit the 'android' folder itself, but ignore the build files inside it.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/*.iml
android/.idea/
android/captures/
android/.externalNativeBuild/
android/.cxx/

# Capacitor - General
capacitor.config.json.timestamp
